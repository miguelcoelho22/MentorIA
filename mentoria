#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_DIR="$ROOT/infrastructure/docker"
K8S_DIR="$ROOT/infrastructure/kubernetes"
GATEWAY_URL="${GATEWAY_URL:-http://localhost:8080}"
SAGA_URL="${SAGA_URL:-http://localhost:8090}"
INGRESS_NGINX_URL="https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.12.1/deploy/static/provider/cloud/deploy.yaml"

STUDENT_EMAIL="ana@demo.mentoria.test"
TEACHER_EMAIL="professor@demo.mentoria.test"
DEMO_PASSWORD="${DEMO_PASSWORD:-MentorIA-demo-2026!}"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '\033[36m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✔\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31m✘\033[0m %s\n' "$*" >&2; exit 1; }

# Python para ler JSON nos atalhos: no Windows (Git Bash) o comando costuma ser "python" ou "py".
PYTHON_CMD=""
py_run() {
  if [[ -z "$PYTHON_CMD" ]]; then
    local candidate
    for candidate in python3 python py; do
      if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import json' >/dev/null 2>&1; then
        PYTHON_CMD="$candidate"; break
      fi
    done
    [[ -n "$PYTHON_CMD" ]] || die "Python 3 não encontrado. Instale em https://www.python.org/downloads/ (marque \"Add python.exe to PATH\") e abra um terminal novo."
  fi
  PYTHONUTF8=1 PYTHONIOENCODING=utf-8 "$PYTHON_CMD" "$@"
}

compose() { docker compose --project-directory "$COMPOSE_DIR" -f "$COMPOSE_DIR/docker-compose.yaml" "$@"; }

ensure_env() {
  local env="$COMPOSE_DIR/.env" example="$COMPOSE_DIR/.env.example"
  if [[ ! -f "$env" ]]; then
    cp "$example" "$env"
    warn "Criei $env a partir do .env.example. Revise as senhas se quiser."
  fi
  local missing=()
  while IFS='=' read -r key _; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    grep -q "^${key}=" "$env" || missing+=("$key")
  done < "$example"
  if (( ${#missing[@]} )); then
    warn "Faltam no .env: ${missing[*]} (copie do .env.example)."
  fi
}

require_docker() {
  command -v docker >/dev/null || die "Docker não encontrado."
  docker info >/dev/null 2>&1 || die "O Docker não está rodando. Abra o Docker Desktop."
}

wait_gateway() {
  info "Aguardando o gateway em $GATEWAY_URL ..."
  for _ in $(seq 1 60); do
    if curl -sf -o /dev/null "$GATEWAY_URL/actuator/health/readiness"; then
      ok "Gateway pronto."
      return 0
    fi
    sleep 3
  done
  die "O gateway não ficou pronto em 3 minutos. Veja: ./mentoria logs gateway"
}

token_for() {
  local email="$1" response
  response=$(curl -s -X POST "$GATEWAY_URL/api/v1/auth/login" \
    -H 'Content-Type: application/json' \
    -d "{\"email\":\"$email\",\"password\":\"$DEMO_PASSWORD\"}")
  py_run -c 'import sys,json
try: print(json.load(sys.stdin)["accessToken"])
except Exception: sys.exit(1)' <<<"$response" || die "Login falhou para $email: $response"
}

status_of() { curl -s -o /dev/null -w '%{http_code}' "$@"; }

check() {
  local name="$1" expected="$2" got="$3"
  if [[ "$got" == "$expected" ]]; then ok "$name → $got"; else warn "$name → $got (esperado $expected)"; FAILED=1; fi
}

cmd_smoke() {
  FAILED=0
  bold "Smoke test do gateway ($GATEWAY_URL)"
  local student teacher
  student=$(token_for "$STUDENT_EMAIL"); ok "Login do aluno"
  teacher=$(token_for "$TEACHER_EMAIL"); ok "Login do professor"

  check "Sem token em /student/home" 401 "$(status_of "$GATEWAY_URL/api/v1/student/home")"
  check "Aluno em /teacher/classes" 403 "$(status_of -H "Authorization: Bearer $student" "$GATEWAY_URL/api/v1/teacher/classes")"
  check "Professor em /student/home" 403 "$(status_of -H "Authorization: Bearer $teacher" "$GATEWAY_URL/api/v1/student/home")"
  check "Rota interna da SAGA" 403 "$(status_of -X PUT -H "Authorization: Bearer $student" "$GATEWAY_URL/api/v1/quota-reservations/x")"

  local headers
  headers=$(curl -s -D - -o /dev/null -H "Authorization: Bearer $student" "$GATEWAY_URL/api/v1/student/home")
  if grep -qi '^x-correlation-id' <<<"$headers" && grep -qi '^x-ratelimit-remaining' <<<"$headers"; then
    ok "Aluno em /student/home chegou ao BFF ($(head -1 <<<"$headers" | tr -d '\r'))"
  else
    warn "Aluno em /student/home não passou pelo gateway como esperado"; FAILED=1
  fi

  local uri="$GATEWAY_URL/api/v1/student/essays/smoke-$RANDOM/correction-requests" third
  status_of -X POST -H "Authorization: Bearer $student" "$uri" >/dev/null
  status_of -X POST -H "Authorization: Bearer $student" "$uri" >/dev/null
  third=$(status_of -X POST -H "Authorization: Bearer $student" "$uri")
  check "3º pedido de correção no mesmo minuto" 429 "$third"

  (( FAILED )) && die "Algum teste falhou." || ok "Tudo certo."
}

cmd_ai_test() {
  docker run --rm -v "$ROOT/ai-service":/app -w /app -e UV_PROJECT_ENVIRONMENT=/tmp/venv \
    ghcr.io/astral-sh/uv:python3.14-bookworm-slim sh -c \
    "apt-get update -qq >/dev/null && apt-get install -y -qq libpq5 >/dev/null 2>&1; uv sync --frozen -q && uv run --frozen pytest -q -p no:warnings"
}

cmd_ai_analyze() {
  local body
  body=$(py_run - <<'EOF'
import json, uuid
text = (
    "Nas grandes cidades brasileiras, milhões de trabalhadores perdem horas diárias no transporte coletivo. "
    "Esse cenário revela que o direito social ao transporte, previsto na Constituição, ainda não é garantido a todos.\n\n"
    "Em primeiro lugar, a urbanização desordenada empurrou a população de baixa renda para as periferias, longe dos empregos. "
    "Além disso, a prioridade dada ao automóvel congestionou as vias e tornou os ônibus mais lentos.\n\n"
    "Portanto, cabe às prefeituras ampliar os corredores exclusivos de ônibus, a fim de reduzir o tempo de deslocamento."
)
print(json.dumps({"studentId": str(uuid.uuid4()), "essayId": str(uuid.uuid4()),
                  "theme": "Desafios da mobilidade urbana no Brasil", "text": text}))
EOF
)
  info "Analisando redação de exemplo (pode levar alguns segundos)..."
  docker run --rm --network docker_app curlimages/curl:8.11.1 -s -X POST http://ai-service:8000/api/v1/analysis \
    -H 'Content-Type: application/json' -d "$body" | py_run -m json.tool --no-ensure-ascii
}

cmd_ai_plan() {
  local body
  body=$(MESSAGE="${1:-Tenho 8 horas por semana e a prova é daqui a 6 semanas. Vou mal em matemática e física e quero melhorar a proposta de intervenção da redação.}" py_run - <<'EOF'
import json, os, uuid
print(json.dumps({
    "studentId": str(uuid.uuid4()),
    "message": os.environ["MESSAGE"],
    "progress": {"averageByCompetency": [{"id": 1, "average": 150}, {"id": 2, "average": 130},
                                         {"id": 3, "average": 120}, {"id": 4, "average": 140},
                                         {"id": 5, "average": 80}], "weakestCompetency": 5},
    "areaLevels": {"matematica": "basico", "natureza": "intermediario"},
}))
EOF
)
  info "Pedindo o plano de estudos (pode levar alguns segundos)..."
  docker run --rm --network docker_app curlimages/curl:8.11.1 -s -X POST http://ai-service:8000/api/v1/study-plans/suggestions \
    -H 'Content-Type: application/json' -d "$body" | py_run -m json.tool --no-ensure-ascii
}

cmd_k8s() {
  local sub="${1:-help}"; shift || true
  command -v kubectl >/dev/null || die "kubectl não encontrado."
  case "$sub" in
    up)
      kubectl get nodes >/dev/null 2>&1 || die "Kubernetes não responde. Ligue-o no Docker Desktop (Settings → Kubernetes)."
      require_docker; ensure_env
      info "Construindo as imagens..."
      compose build
      if ! kubectl get ns ingress-nginx >/dev/null 2>&1; then
        info "Instalando o Ingress NGINX..."
        kubectl apply -f "$INGRESS_NGINX_URL"
        kubectl wait -n ingress-nginx --for=condition=ready pod \
          -l app.kubernetes.io/component=controller --timeout=180s
      fi
      (cd "$ROOT" && bash "$K8S_DIR/deploy.sh")
      info "Reiniciando os pods para usar as imagens novas..."
      kubectl -n mentoria rollout restart deployment
      ok "Pronto. API em http://localhost/api, apps em http://localhost/student/ e /teacher/"
      ;;
    down)   kubectl delete namespace mentoria ;;
    status) kubectl -n mentoria get pods,svc,ingress ;;
    logs)   kubectl -n mentoria logs -f "deployment/${1:?informe o deployment, ex.: gateway}" ;;
    smoke)  GATEWAY_URL="http://localhost" cmd_smoke ;;
    *) cat <<EOF
Uso: ./mentoria k8s <up|down|status|logs <deployment>|smoke>
EOF
    ;;
  esac
}


# ------------------------------------------------------------------ SAGA (demonstração sem frontend)

json_get() { py_run -c 'import sys,json
data=json.load(sys.stdin)
for key in sys.argv[1].split("."):
    data=data[int(key)] if isinstance(data,list) else data.get(key)
print("" if data is None else data)' "$1"; }

api() {
  local method="$1" path="$2" body="${3:-}"
  if [[ -n "$body" ]]; then
    curl -s -X "$method" "$GATEWAY_URL$path" -H "Authorization: Bearer $SAGA_TOKEN" -H 'Content-Type: application/json' -d "$body"
  else
    curl -s -X "$method" "$GATEWAY_URL$path" -H "Authorization: Bearer $SAGA_TOKEN"
  fi
}

show_quota() {
  api GET /api/v1/student/quota | py_run -c 'import sys,json
q=json.load(sys.stdin)
print("  cota %s: disponiveis=%s reservadas=%s consumidas=%s" % (q.get("period"), q.get("available"), q.get("reserved"), q.get("consumed")))'
}

show_saga() {
  curl -s "$SAGA_URL/api/v1/sagas/$1" | py_run -c 'import sys,json
s=json.load(sys.stdin)
fail=" (%s: %s)" % (s.get("failureReason"), s.get("failureDetail")) if s.get("failureReason") else ""
print("  SAGA %s - status %s%s" % (s.get("id"), s.get("status"), fail))
for step in s.get("steps", []):
    print("    %s  %-28s %s" % (str(step.get("at"))[11:19], step.get("step"), step.get("detail") or ""))'
}

# Roda a SAGA de ponta a ponta pelo gateway e pelo BFF do aluno: cria uma redação, pede a correção,
# acompanha o estado e mostra os passos do orquestrador, a cota e o modelo de leitura do CQRS.
run_saga() {
  local email="${1:-$STUDENT_EMAIL}" wait_seconds="${2:-150}"
  SAGA_TOKEN=$(token_for "$email")
  local theme essay request status=PROCESSING
  theme=$(api GET /api/v1/student/themes | json_get 0.id)
  [[ -n "$theme" ]] || die "Não encontrei temas no BFF do aluno."
  essay=$(api POST /api/v1/student/essays "$(py_run -c 'import json,sys; print(json.dumps({"themeId": sys.argv[1], "text": (
"A mobilidade urbana no Brasil ainda é marcada pela desigualdade. Quem mora nas periferias gasta horas por dia no transporte coletivo, "
"o que reduz o tempo de estudo, de descanso e de convivência familiar.\n\n"
"Em primeiro lugar, a expansão desordenada das cidades afastou a população de baixa renda dos empregos. Além disso, a prioridade dada "
"ao automóvel congestionou as vias e tornou os ônibus mais lentos e caros.\n\n"
"Portanto, cabe às prefeituras, com apoio do Ministério das Cidades, ampliar os corredores exclusivos de ônibus e integrar as tarifas, "
"a fim de reduzir o tempo de deslocamento e garantir o direito à cidade.")}))' "$theme")" | json_get id)
  [[ -n "$essay" ]] || die "Não foi possível criar a redação."
  ok "Redação criada: $essay (tema $theme)"
  info "Antes da correção:"; show_quota
  local response
  response=$(api POST "/api/v1/student/essays/$essay/correction-requests")
  request=$(json_get id <<<"$response" 2>/dev/null || true)
  [[ -n "$request" ]] || die "A correção não foi aceita: ${response:-sem resposta} (o gateway aceita 2 pedidos de correção por minuto; espere um pouco)."
  ok "Correção solicitada (202 Accepted): $request"
  info "Aguardando a SAGA (até ${wait_seconds}s)..."
  for _ in $(seq 1 $((wait_seconds / 3))); do
    status=$(api GET "/api/v1/student/correction-requests/$request" | json_get status 2>/dev/null || echo PROCESSING)
    [[ "$status" != "PROCESSING" && -n "$status" ]] && break
    sleep 3
  done
  bold "Estado final no Assessment: $status"
  show_saga "$request"
  info "Depois da correção:"; show_quota
  if [[ "$status" == "COMPLETED" ]]; then
    info "Feedback publicado (BFF do aluno):"
    api GET "/api/v1/student/feedbacks/$request" | py_run -c 'import sys,json
f=json.load(sys.stdin)
print("  nota total %s" % f.get("totalScore"))
for c in f.get("competencies", []):
    print("  C%s=%s: %s" % (c.get("id"), c.get("score"), (c.get("comment") or "")[:110]))'
    sleep 2
    info "Modelo de leitura do CQRS (Study Plan) atualizado pelo evento FeedbackPublished:"
    api GET /api/v1/student/plan | py_run -c 'import sys,json
p=json.load(sys.stdin)
print("  atualizado em %s" % p.get("updatedAt"))
for t in p.get("tasks", []):
    print("  - [%s] C%s %s" % (t.get("status"), t.get("competency"), t.get("title")))'
  fi
}

cmd_saga_fail() {
  local timeout
  timeout=$(grep -E '^SAGA_ANALYSIS_TIMEOUT=' "$COMPOSE_DIR/.env" 2>/dev/null | cut -d= -f2)
  bold "SAGA com falha: o AI Service será derrubado durante a correção"
  compose stop ai-service >/dev/null
  # Religa o AI Service mesmo se o teste parar no meio.
  trap 'compose start ai-service >/dev/null 2>&1 && ok "AI Service de volta."' EXIT
  warn "AI Service parado. A SAGA vai reservar a cota, esperar a análise (${timeout:-60s}) e compensar."
  run_saga "${1:-$STUDENT_EMAIL}" 150 || true
  info "Subindo o AI Service de novo..."
}

