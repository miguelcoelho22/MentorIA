  cat <<EOF
$(bold "MentorIA — atalhos locais")

Docker Compose:
  ./mentoria start [serviço...]   Sobe tudo (ou só os serviços indicados), reconstruindo as imagens
  ./mentoria gateway              Sobe só o necessário para testar o gateway (Account + BFFs + Gateway)
  ./mentoria stop                 Para os containers (mantém os dados)
  ./mentoria restart <serviço>    Reconstrói e reinicia um serviço
  ./mentoria reset                Derruba tudo e APAGA os volumes (bancos zerados)
  ./mentoria ps                   Lista os containers
  ./mentoria logs [serviço]       Acompanha os logs
  ./mentoria token [student|teacher]  Faz login e imprime o JWT
  ./mentoria smoke                Testa o gateway (401, 403, roteamento, 429)
  ./mentoria test                 Roda os testes Maven do gateway
  ./mentoria ai-ingest            Sincroniza o corpus do RAG com o pgvector
  ./mentoria ai-test              Roda os testes do AI Service (em container, sem Python local)
  ./mentoria ai-analyze           Envia uma redação de exemplo para a análise com IA
  ./mentoria ai-import            Baixa o Essay-BR e regenera o corpus de redações reais e o conjunto de avaliação
  ./mentoria ai-eval [N]          Compara as notas da IA com as notas humanas de N redações (padrão 20), com e sem RAG
  ./mentoria ai-plan ["pedido"]   Pede um plano de estudos à IA (com um pedido de exemplo se nenhum for informado)
  ./mentoria ai-plan-eval         Testa o plano de estudos com pedidos legítimos e tentativas de ataque
  ./mentoria ai-eval-report [N]   Gera docs/avaliacao-rag.md: N redações (padrão 5), nota humana × IA com e sem RAG
  ./mentoria ai-metrics           Latência medida, tokens, custo estimado, cache e circuit breaker do AI Service

SAGA (sem frontend, passando por gateway → BFF → serviços):
  ./mentoria saga [email]         Caminho feliz: cria uma redação, pede a correção e mostra os passos da SAGA
  ./mentoria saga-falha [email]   Falha provocada: derruba o AI Service, pede a correção e mostra a compensação
  ./mentoria sagas                Lista as últimas SAGAs do orquestrador

Kubernetes (Docker Desktop):
  ./mentoria k8s up|down|status|logs <deployment>|smoke

Endereços: gateway $GATEWAY_URL · aluno http://localhost:3000/student/ · professor http://localhost:3001/teacher/
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    start|up)
      require_docker; ensure_env
      compose up -d --build "$@"
      [[ $# -eq 0 || " $* " == *" gateway "* ]] && wait_gateway
      cmd_help | tail -1
      ;;
    gateway)
      require_docker; ensure_env
      compose up -d --build postgres-account account
      compose up -d --build --no-deps bff-student bff-teacher gateway
      wait_gateway
      info "Rode ./mentoria smoke para testar."
      ;;
    stop|down)   compose down ;;
    restart)     [[ $# -gt 0 ]] || die "Informe o serviço, ex.: ./mentoria restart gateway"
                 compose up -d --build --no-deps "$@" ;;
    reset)
      read -r -p "Isso apaga TODOS os dados dos bancos. Continuar? [s/N] " answer
      [[ "$answer" =~ ^[sS]$ ]] && compose down -v || info "Cancelado."
      ;;
    ps|status)   compose ps ;;
    logs)        compose logs -f --tail=100 "$@" ;;
    token)
      case "${1:-student}" in
        student|aluno)     token_for "$STUDENT_EMAIL" ;;
        teacher|professor) token_for "$TEACHER_EMAIL" ;;
        *) die "Use: ./mentoria token [student|teacher]" ;;
      esac
      ;;
    smoke)       cmd_smoke ;;
    test)        (cd "$ROOT/gateway" && mvn -q test) && ok "Testes do gateway passaram." ;;
    ai-ingest)   compose exec ai-service python -m ai_service.ingest ;;
    ai-test)     require_docker; cmd_ai_test ;;
    ai-analyze)  require_docker; cmd_ai_analyze ;;
    ai-import)   py_run -I "$ROOT/ai-service/scripts/import_essay_br.py" "$@" && info "Rode ./mentoria restart ai-service para vetorizar o corpus novo." ;;
    ai-eval)     compose exec ai-service python -m ai_service.evaluate --limit "${1:-20}" ;;
    ai-eval-report)
                 compose exec -T ai-service python -m ai_service.evaluate --limit "${1:-5}" --markdown \
                   > "$ROOT/docs/avaliacao-rag.md" && ok "Relatório salvo em docs/avaliacao-rag.md (preencha a seção Análise)." ;;
    ai-plan)     require_docker; cmd_ai_plan "${1:-}" ;;
    ai-plan-eval) compose exec ai-service python -m ai_service.plan_eval "$@" ;;
    ai-metrics)  require_docker; docker run --rm --network docker_app curlimages/curl:8.11.1 -s \
                   http://ai-service:8000/api/v1/metrics | py_run -m json.tool --no-ensure-ascii ;;
    saga)        require_docker; run_saga "${1:-$STUDENT_EMAIL}" ;;
    saga-falha|saga-fail) require_docker; cmd_saga_fail "${1:-}" ;;
    sagas)       curl -s "$SAGA_URL/api/v1/sagas" | py_run -m json.tool --no-ensure-ascii ;;
    k8s)         cmd_k8s "$@" ;;
    help|-h|--help) cmd_help ;;
    *) warn "Comando desconhecido: $cmd"; cmd_help; exit 1 ;;
  esac
}

main "$@"
